<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Balayage radar : secteur de 75° derrière l'aiguille, fondu angulaire
         (transparent -> or). Le sweep part de 3h et tourne horaire :
         195° = 0.5417, 270° (12h) = 0.75. Zone sûre adaptive : rayon <= 33. -->
    <path android:pathData="M54,54 L25.02,46.24 A30,30 0 0 1 54,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="sweep"
                android:centerX="54"
                android:centerY="54">
                <item android:offset="0" android:color="#00E5A83B" />
                <item android:offset="0.5417" android:color="#00E5A83B" />
                <item android:offset="0.75" android:color="#D9F0B84D" />
                <item android:offset="1" android:color="#00E5A83B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Anneaux de portée : contours fins, alpha décroissant vers l'extérieur -->
    <path
        android:pathData="M54,54m-12,0a12,12 0 1,0 24,0a12,12 0 1,0 -24,0"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.6"
        android:strokeWidth="1.4"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,54m-21,0a21,21 0 1,0 42,0a21,21 0 1,0 -42,0"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.4"
        android:strokeWidth="1.4"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,54m-30,0a30,30 0 1,0 60,0a30,30 0 1,0 -60,0"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.25"
        android:strokeWidth="1.4"
        android:fillColor="#00000000" />

    <!-- Aiguille du radar : bord avant du balayage, vers 12h -->
    <path
        android:pathData="M54,54 L54,24"
        android:strokeColor="#F0B84D"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- Appareil fraîchement détecté dans le balayage : nœud or + halo -->
    <path
        android:pathData="M39.9,37.2m-5.4,0a5.4,5.4 0 1,0 10.8,0a5.4,5.4 0 1,0 -10.8,0"
        android:strokeColor="#F0B84D"
        android:strokeAlpha="0.45"
        android:strokeWidth="1.3"
        android:fillColor="#00000000" />
    <path
        android:pathData="M39.9,37.2m-3.1,0a3.1,3.1 0 1,0 6.2,0a3.1,3.1 0 1,0 -6.2,0"
        android:fillColor="#F0B84D" />

    <!-- Appareils déjà cartographiés : nœuds blancs sur les anneaux -->
    <path
        android:pathData="M71,49m-2.7,0a2.7,2.7 0 1,0 5.4,0a2.7,2.7 0 1,0 -5.4,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.9" />
    <path
        android:pathData="M42,68m-2.7,0a2.7,2.7 0 1,0 5.4,0a2.7,2.7 0 1,0 -5.4,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.9" />
    <path
        android:pathData="M63,71m-2.7,0a2.7,2.7 0 1,0 5.4,0a2.7,2.7 0 1,0 -5.4,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.75" />

    <!-- Cœur du scanner : moyeu or, liseré sombre pour le détacher des anneaux -->
    <path
        android:pathData="M54,54m-4.6,0a4.6,4.6 0 1,0 9.2,0a4.6,4.6 0 1,0 -9.2,0"
        android:strokeColor="#071B36"
        android:strokeAlpha="0.35"
        android:strokeWidth="1.6"
        android:fillColor="#F0B84D" />
</vector>
